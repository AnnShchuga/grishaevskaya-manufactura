function buildAll(){
  const tabs = document.getElementById('pageTabs');
  const pagesRoot = document.getElementById('pages');
  NAV.forEach(([key,label],i)=>{
    const btn = el('button','', label);
    btn.dataset.pageBtn = key;
    if(i===0) btn.classList.add('active');
    btn.onclick = ()=>showPage(key);
    tabs.appendChild(btn);

    const def = PAGES[key];
    const page = el('div','page'+(i===0?' active':''));
    page.id = 'page-'+key;
    let html = blockRow(
      "Шапка (сквозная, на всех страницах)",
      renderHeader(key),
      "Одинакова на всех шести страницах — логотип, меню, CTA всегда на виду, человек не теряет связь с остальным сайтом. В реальном сайте прилипает к верху при скролле.",
      true
    );
    html += `<div class="page-title"><h1>${def.title}</h1><p>${def.sub}</p></div>`;
    def.blocks.forEach(([name,content,anno,anchorId])=>{ html += blockRow(name, content, anno, false, anchorId); });
    html += blockRow(
      "Подвал (сквозной, на всех страницах)",
      renderFooter(),
      "Контакты, ссылки на все разделы, соцсети и юридическая информация — последний шанс поймать человека, который долистал до конца, но ещё не оставил заявку.",
      true
    );
    page.innerHTML = html;
    pagesRoot.appendChild(page);
  });
  pagesRoot.addEventListener('click', e=>{
    const burger = e.target.closest('.burger');
    if(burger){
      e.preventDefault();
      const nav = burger.closest('.site-header').querySelector('.navlinks');
      nav.classList.toggle('open');
      return;
    }
    const a = e.target.closest('[data-goto]');
    if(a){ e.preventDefault(); document.querySelectorAll('.navlinks.open').forEach(n=>n.classList.remove('open')); showPage(a.dataset.goto, a.dataset.scroll); }
  });
}
function showPage(key, scrollId){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById('page-'+key).classList.add('active');
  document.querySelectorAll('#pageTabs button').forEach(b=>b.classList.toggle('active', b.dataset.pageBtn===key));
  if(scrollId){
    const target = document.getElementById(scrollId);
    if(target){ target.scrollIntoView({behavior:'instant', block:'start'}); return; }
  }
  window.scrollTo({top:0,behavior:'instant'});
}
document.getElementById('bpTabs').addEventListener('click', e=>{
  const b = e.target.closest('button'); if(!b) return;
  document.body.dataset.bp = b.dataset.bpBtn;
  document.querySelectorAll('#bpTabs button').forEach(x=>x.classList.toggle('active', x===b));
});

buildAll();
</script>
