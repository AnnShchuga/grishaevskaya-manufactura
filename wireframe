<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Гришаевская Мануфактура — вайрфрейм сайта</title>
<style>
  :root{
    --bg:#fafafa; --panel:#f2f2f2; --panel2:#f9f9f9; --line:#c9c9c9; --line2:#d8d8d8;
    --ink:#171717; --sub:#5a5a5a; --anno:#5c5c5c; --white:#fff; --img:#d1d1d1; --img-line:#a6a6a6;
    --accent:#171717;
    /* золотое сечение: ритм отступов и типографика построены по числам Фибоначчи (≈φ=1.618) */
    --sp-1:8px; --sp-2:13px; --sp-3:21px; --sp-4:34px; --sp-5:55px; --sp-6:89px;
    --pad-desktop:var(--sp-5); --pad-tablet:var(--sp-4); --pad-mobile:var(--sp-2);
    --fs-1:8px; --fs-2:13px; --fs-3:21px; --fs-4:34px; --fs-5:55px;
  }
  *{box-sizing:border-box;}
  body{margin:0;font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:var(--bg);color:var(--ink);}
  /* ===== top control bar ===== */
  .controlbar{position:sticky;top:0;z-index:50;background:#1c1c1c;color:#fff;display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:10px 16px;font-size:13px;}
  .controlbar .grp{display:flex;gap:6px;flex-wrap:wrap;}
  .controlbar button{background:#333;color:#ddd;border:1px solid #444;border-radius:6px;padding:6px 12px;font-size:12.5px;cursor:pointer;}
  .controlbar button.active{background:#fff;color:#111;border-color:#fff;font-weight:600;}
  .controlbar .sep{width:1px;align-self:stretch;background:#444;margin:0 4px;}
  .controlbar .hint{margin-left:auto;color:#999;font-size:11.5px;}

  /* ===== page shell ===== */
  #stage{max-width:1440px;margin:0 auto;background:var(--bg);}
  [data-bp="tablet"] #stage{max-width:834px;}
  [data-bp="mobile"] #stage{max-width:375px;}

  .page{display:none;}
  .page.active{display:block;}

  /* ===== header (persistent) ===== */
  .site-header{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-2);flex-wrap:wrap;padding:var(--sp-3) var(--pad-desktop);background:#fff;}
  [data-bp="tablet"] .site-header{padding:var(--sp-2) var(--pad-tablet);}
  [data-bp="mobile"] .site-header{padding:var(--sp-2) var(--pad-mobile);}
  .logo{font-weight:800;font-size:15px;letter-spacing:.02em;white-space:nowrap;}
  .navlinks{display:flex;gap:18px;flex-wrap:wrap;}
  [data-bp="mobile"] .site-header{flex-wrap:wrap;}
  [data-bp="mobile"] .navlinks{display:none;width:100%;flex-direction:column;gap:0;order:5;margin-top:var(--sp-2);}
  [data-bp="mobile"] .navlinks.open{display:flex;}
  [data-bp="mobile"] .navlinks a{padding:10px 0;border-top:1px solid var(--line2);border-bottom:none;}
  .navlinks a{font-size:12.5px;color:var(--sub);text-decoration:none;padding:4px 0;border-bottom:2px solid transparent;}
  .navlinks a.current{color:var(--ink);border-color:var(--ink);font-weight:600;}
  .burger{display:none;font-size:12px;border:1px solid var(--line);border-radius:6px;padding:6px 10px;background:#fff;}
  [data-bp="mobile"] .burger{display:inline-block;}
  .hcta{background:#171717;color:#fff;font-size:12px;font-weight:600;padding:8px 14px;border-radius:6px;white-space:nowrap;}
  [data-bp="mobile"] .hcta{font-size:11px;padding:7px 10px;}

  /* ===== title block ===== */
  .page-title{padding:var(--sp-4) var(--pad-desktop) var(--sp-1);}
  [data-bp="tablet"] .page-title{padding:var(--sp-3) var(--pad-tablet) var(--sp-1);}
  [data-bp="mobile"] .page-title{padding:var(--sp-2) var(--pad-mobile) var(--sp-1);}
  .page-title h1{font-size:var(--fs-3);margin:0 0 4px;}
  [data-bp="mobile"] .page-title h1{font-size:var(--fs-2);}
  .page-title p{margin:0;font-size:12px;color:var(--sub);}

  /* ===== block row: content + annotation ===== */
  .block-row{display:flex;gap:var(--sp-3);padding:var(--sp-2) var(--pad-desktop);align-items:flex-start;}
  [data-bp="tablet"] .block-row{padding:var(--sp-2) var(--pad-tablet);gap:var(--sp-2);}
  [data-bp="mobile"] .block-row{flex-direction:column;padding:var(--sp-1) var(--pad-mobile);gap:var(--sp-1);}

  .block{flex:1 1 auto;min-width:0;border:1px dashed var(--line);padding:16px 18px;border-radius:2px;}
  .block.tight{padding:0;overflow:hidden;}
  .tight-label{margin:0;padding:var(--sp-2) var(--pad-desktop) 0;font-size:12.5px;text-transform:uppercase;letter-spacing:.02em;}
  [data-bp="tablet"] .tight-label{padding:var(--sp-2) var(--pad-tablet) 0;}
  [data-bp="mobile"] .tight-label{padding:var(--sp-1) var(--pad-mobile) 0;font-size:11px;}
  .block h3{font-size:12.5px;margin:0 0 10px;letter-spacing:.02em;text-transform:uppercase;}
  [data-bp="mobile"] .block h3{font-size:11px;}

  .anno{flex:0 0 260px;font-size:11px;color:var(--anno);line-height:1.4;padding-top:16px;}
  [data-bp="tablet"] .anno{flex-basis:190px;}
  [data-bp="mobile"] .anno{flex-basis:auto;padding-top:2px;font-size:10.5px;font-style:italic;}
  .anno b{color:var(--ink);}

  /* ===== generic content atoms ===== */
  .imgbox{background:var(--img);border:1px solid var(--img-line);display:flex;align-items:center;justify-content:center;color:#555;font-size:10px;text-align:center;padding:4px;width:100%;aspect-ratio:1.618/1;height:auto;}
  .row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
  .pill{display:inline-flex;align-items:center;padding:9px 16px;border-radius:6px;font-size:12px;font-weight:600;white-space:nowrap;}
  .pill.filled{background:#171717;color:#fff;}
  .pill.outline{background:#fff;border:1px solid #999;color:#171717;}
  .chip{display:inline-flex;align-items:center;padding:6px 12px;border-radius:14px;font-size:11px;background:#fff;border:1px solid var(--line);color:#333;}
  .cardgrid{display:grid;gap:12px;grid-template-columns:repeat(3,1fr);}
  [data-bp="tablet"] .cardgrid{grid-template-columns:repeat(2,1fr);}
  [data-bp="mobile"] .cardgrid{grid-template-columns:1fr;}
  .card{background:#fff;border:1px solid var(--line);padding:10px;display:flex;flex-direction:column;gap:6px;}
  .card .t{font-size:12px;font-weight:600;}
  .card .s{font-size:10px;color:var(--sub);}
  .heading{font-size:var(--fs-5);font-weight:800;margin:6px 0;line-height:1.05;}
  [data-bp="tablet"] .heading{font-size:var(--fs-4);}
  [data-bp="mobile"] .heading{font-size:var(--fs-3);}
  .sub{font-size:13px;color:var(--sub);margin:0 0 4px;}
  [data-bp="mobile"] .sub{font-size:11px;}
  .steps{display:flex;gap:6px;align-items:center;flex-wrap:wrap;}
  [data-bp="mobile"] .steps{flex-direction:column;align-items:flex-start;}
  .step-item{display:flex;flex-direction:column;align-items:center;gap:4px;}
  [data-bp="mobile"] .step-item{flex-direction:row;gap:8px;}
  .step-item .n{width:26px;height:26px;border-radius:50%;background:#fff;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;}
  .step-item .lab{font-size:10px;color:var(--sub);text-align:center;}
  .arrow{color:#999;font-size:12px;}
  .faqrow{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid var(--line);padding:9px 12px;margin-bottom:6px;font-size:11.5px;}
  .field{background:#fff;border:1px solid var(--line);height:36px;display:flex;align-items:center;padding:0 12px;font-size:10.5px;color:#888;margin-bottom:8px;}
  .textblock h4{font-size:14px;margin:0 0 6px;}
  .textblock p{font-size:11.5px;color:var(--sub);margin:0;line-height:1.5;}
  .aboutwrap{display:flex;gap:var(--sp-3);align-items:flex-start;}
  .aboutwrap .imgbox{flex:0 0 38.2%;}
  .aboutwrap .textblock{flex:1 1 61.8%;}
  [data-bp="mobile"] .aboutwrap{flex-direction:column;}
  [data-bp="mobile"] .aboutwrap .imgbox{flex-basis:auto;width:100%;}
  .filterbar .chip{background:#fff;}

  /* ===== footer (persistent) ===== */
  .site-footer{background:#1c1c1c;color:#ccc;padding:var(--sp-4) var(--pad-desktop);}
  [data-bp="tablet"] .site-footer{padding:var(--sp-3) var(--pad-tablet);}
  [data-bp="mobile"] .site-footer{padding:var(--sp-2) var(--pad-mobile);}
  .footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:24px;}
  [data-bp="tablet"] .footer-grid{grid-template-columns:1fr 1fr;}
  [data-bp="mobile"] .footer-grid{grid-template-columns:1fr;gap:16px;}
  .footer-grid h5{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:#888;margin:0 0 10px;}
  .footer-grid a{display:block;color:#ddd;text-decoration:none;font-size:12px;margin-bottom:6px;}
  .footer-bottom{border-top:1px solid #333;margin-top:24px;padding-top:14px;font-size:10.5px;color:#777;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;}
</style>
</head>
<body data-bp="desktop">

<div class="controlbar">
  <div class="grp" id="pageTabs"></div>
  <div class="sep"></div>
  <div class="grp" id="bpTabs">
    <button data-bp-btn="desktop" class="active">Desktop 1440</button>
    <button data-bp-btn="tablet">Планшет 834</button>
    <button data-bp-btn="mobile">Мобайл 375</button>
  </div>
  <div class="hint">Курсивом сбоку/снизу каждого блока — пометка, зачем он нужен</div>
</div>

<div id="stage"><div id="pages"></div></div>

<script>
const NAV = [
  ["main","Главная"],["services","Услуги"],["portfolio","Портфолио"],
  ["materials","Материалы"],["expert","Экспертная страница"]
];

function el(tag, cls, html){ const e=document.createElement(tag); if(cls) e.className=cls; if(html!=null) e.innerHTML=html; return e; }
function imgbox(label){ return el('div','imgbox',label||'фото'); } // высота больше не задаётся вручную — держит золотой прямоугольник 1.618:1 через CSS aspect-ratio
function pill(text, filled){ return `<span class="pill ${filled?'filled':'outline'}">${text}</span>`; }
function chip(text){ return `<span class="chip">${text}</span>`; }

function renderHeader(currentKey){
  const links = NAV.filter(([k])=>k!=='main').map(([k,label])=>
    `<a href="#" class="${k===currentKey?'current':''}" data-goto="${k}">${label}</a>`).join('');
  return `<div class="site-header">
    <div class="logo">ГРИШАЕВСКАЯ МАНУФАКТУРА</div>
    <div class="navlinks"><a href="#" class="${currentKey==='main'?'current':''}" data-goto="main">Главная</a><a href="#" data-goto="main" data-scroll="about-block">О компании</a>${links}</div>
    <div class="burger">☰</div>
    <div class="hcta">${pill('Обсудим проект?',true)}</div>
  </div>`;
}
function renderFooter(){
  return `<div class="site-footer"><div class="footer-grid">
    <div><h5>Гришаевская Мануфактура</h5>
      <div style="font-size:12px;color:#aaa;line-height:1.6;">Мебель, которая служит вам — не вы ей.<br>Кухни, шкафы, гардеробные и мебель<br>для всей квартиры на заказ, под ключ.</div></div>
    <div><h5>Разделы</h5><a href="#" data-goto="main">Главная</a><a href="#" data-goto="main" data-scroll="about-block">О компании</a>${NAV.filter(([k])=>k!=='main').map(([k,l])=>`<a href="#" data-goto="${k}">${l}</a>`).join('')}</div>
    <div><h5>Контакты</h5><a href="#">+7 (___) ___-__-__</a><a href="#">WhatsApp</a><a href="#">Telegram</a><a href="#">example@mail.ru</a></div>
    <div><h5>Соцсети</h5><a href="#">Instagram*</a><a href="#">VK</a><a href="#">Дзен</a></div>
  </div>
  <div class="footer-bottom"><span>© Гришаевская Мануфактура, ИП Гришаев Е.Н.</span><span>Политика конфиденциальности · Договор оферты</span></div>
  </div>`;
}

function blockRow(name, contentHtml, anno, tight, anchorId){
  return `<div class="block-row"${anchorId?` id="${anchorId}"`:''}>
    <div class="block${tight?' tight':''}"><h3${tight?' class="tight-label"':''}>${name}</h3>${contentHtml}</div>
    <div class="anno">→ ${anno}</div>
  </div>`;
}

function heroContent(){
  return `<div class="heading">Мебель должна служить вам — а не вы мебели</div>
  <p class="sub">Мебель на заказ для тех, кто хочет получить понятный результат без лишнего контроля с вашей стороны — от замера до монтажа.</p>
  <div class="row" style="margin:10px 0;">${pill('Обсудим проект?',true)} ${pill('Написать нам',false)}</div>
  <div class="row" style="margin-bottom:12px;">${['Договор','Гарантия 1 год','Сроки 2–3 недели'].map(chip).join('')}</div>
  <div class="imgbox">фото — лучшие проекты</div>`;
}
function chipsContent(items){ return `<div class="row">${items.map(chip).join('')}</div>`; }
function trustContent(problem, solution, chips){
  return `<p class="sub" style="margin-bottom:4px;"><b>${problem}</b></p>
  <p class="sub" style="margin-bottom:10px;">${solution}</p>
  <div class="imgbox" style="margin-bottom:10px;">видео — Евгений о компании, 40–60 сек</div>
  <div class="row">${chips.map(chip).join('')}</div>`;
}
function cardsContent(items, imgH){
  return `<div class="cardgrid">${items.map(([t,s])=>`<div class="card">${imgH?imgbox('фото',imgH).outerHTML:''}<div class="t">${t}</div>${s?`<div class="s">${s}</div>`:''}</div>`).join('')}</div>`;
}
function stepsContent(items){
  return `<div class="steps">${items.map((s,i)=>`<div class="step-item"><div class="n">${i+1}</div><div class="lab">${s}</div></div>${i<items.length-1?'<span class="arrow">→</span>':''}`).join('')}</div>`;
}
function faqContent(items){
  return items.map(q=>`<div class="faqrow"><span>${q}</span><b>+</b></div>`).join('');
}
function formContent(fields, submit){
  return fields.map(f=>`<div class="field">${f}</div>`).join('') + `<div>${pill(submit,true)}</div>`;
}
function textContent(title, text){
  return `<div class="textblock">${title?`<h4>${title}</h4>`:''}${text?`<p>${text}</p>`:''}</div>`;
}
function filterContent(items){ return `<div class="row filterbar">${items.map(chip).join('')}</div>`; }
function articleContent(){
  return `<div class="imgbox">фото/видео к материалу</div>
  <div class="textblock" style="margin-top:8px;"><h4>Заголовок материала (пример)</h4>
  <p>Короткий текст материала — 3–5 абзацев, отвечает на конкретный частый вопрос клиента.</p></div>`;
}
function aboutContent(){
  return `<div class="aboutwrap">${imgbox('фото — мастерская / команда').outerHTML}
  <div class="textblock"><h4>Евгений Гришаев — основатель</h4>
  <p>История компании, почему появилась, личная ответственность за результат от заказа до сдачи. Монтаж — постоянная команда: Рифат, Алексей и Кирилл. В отзывах клиенты хвалят именно их за аккуратность отдельно от Евгения — это редкая деталь, у конкурентов монтаж обычно безликий.</p></div></div>`;
}
function menuContent(items){
  return `<div class="cardgrid">${items.map(([t,s])=>`<div class="card">${imgbox('фото',150).outerHTML}<div class="t">${t}</div><div class="s">${s}</div></div>`).join('')}</div>`;
}

const PAGES = {
 main:{title:"ГЛАВНАЯ",sub:"Лендинг, 10 секций.",blocks:[
   ["01 · Первый экран (Hero)",heroContent(),"Заголовок и фото решают, останется ли пользователь. CTA виден без скролла. Интерактив: наведение/тап открывает фасады кухни (курсор-reveal или hover-zone) — статичное фото ниже лишь заглушка, см. прототип grishaev_hero.jsx."],
   ["02 · Блок доверия",trustContent("После ремонта — ещё и мебель ждать, снова всё контролировать самому?","Мы берём полный цикл на себя: от замера до монтажа — и держим на связи одного человека, а не разных подрядчиков на каждом этапе.",["60 отзывов","Рейтинг 4,93","Работа по договору","Гарантия 1 год","Своё производство","Сроки 2–3 недели"]),"Проблема → решение вместо сухих цифр — снимает недоверие до того, как пользователь пойдёт искать отзывы на стороне. Видео Евгения — сюда, сразу после проблемы/решения: рациональное доверие (цифры) и эмоциональное (живой голос) работают сильнее рядом, чем порознь."],
   ["03 · Что мы производим",cardsContent([["Кухни","на заказ, любая планировка"],["Шкафы","встроенные и корпусные"],["Гардеробные","под любой метраж"],["Мебель для квартиры","полная мебелировка"],["Прихожие","с учётом входной группы"],["Тумбы, комоды, столы","штучные изделия"]],110),"Широта услуг одним взглядом — через фото направлений, не текстом."],
   ["04 · Реализованные проекты",cardsContent([["Кухня, ЖК «Символ»","14 дней · от 320 000 ₽"],["Гардеробная, Балашиха","10 дней · от 210 000 ₽"],["Мебель для квартиры","21 день · от 480 000 ₽"],["Шкаф-купе, Реутов","7 дней · от 180 000 ₽"],["Кухня, вторичка","16 дней · от 340 000 ₽"],["Прихожая + гардероб","12 дней · от 260 000 ₽"]],120),"Задача клиента + решение + срок в каждой карточке. Полный список — на странице «Портфолио»."],
   ["05 · Почему выбирают нас",cardsContent([["Фиксированная цена","после замера не меняется"],["Соблюдение сроков","делаем, как договорились"],["Опытные монтажники","аккуратно, без переделок"],["Личный контроль владельца","от заказа до сдачи"],["Полный цикл работ","один подрядчик"],["Чистота на объекте","убираем за собой"]],0),"Конкретные причины из отзывов, не абстрактные «преимущества»."],
   ["06 · Как проходит работа",stepsContent(["Консультация","Замер","Проектирование","Согласование","Производство","Монтаж","Приёмка"]),"Семь понятных шагов вместо туманного «мы всё сделаем»."],
   ["07 · Истории клиентов",cardsContent([["«Всё сделали в срок, не пришлось напоминать»","Анна, кухня"],["«Монтажники аккуратные, убрали за собой»","Дмитрий, гардеробная"],["«Приятно, что Евгений держал руку на пульсе»","Мария, вся квартира"]],0),"Живые истории подтверждают именно то, что обещано в блоке преимуществ."],
   ["08 · О компании",aboutContent(),"Делает бренд человечным — за компанией конкретный человек и постоянная команда, а не безликое ООО.","about-block"],
   ["09 · FAQ",faqContent(["Какие сроки изготовления?","Сколько стоит кухня/шкаф?","Какая гарантия?","Какие материалы используете?","Как проходит замер?","Что входит в стоимость?"]),"Закрывает последние возражения перед формой."],
   ["10 · Форма заявки",formContent(["Ваше имя","Телефон"],"Написать нам"),"Минимум полей, чтобы не терять заявки на длинной форме. Идёт сразу после FAQ — ничего не должно перебивать путь клиента к заявке в момент, когда он готов её оставить."],
   ["11 · Партнёрам",textContent("","Дизайнер интерьеров, риелтор или застройщик? Предлагаем сотрудничество — комиссия с заказа, отдельный контакт для быстрой связи.")+`<div>${pill('Стать партнёром',false)}</div>`,"Боковое предложение для другой аудитории — сознательно последним блоком перед подвалом, чтобы не перебивать основной путь клиента к заявке."],
 ]},
